// https://docs.deno.com/runtime/fundamentals/configuration/
// Auto-generated: Deno has no fields for authors, keywords or URLs. Keep them in README.md and the AppStream file.

{
  "name": "@project-organization/project-name",
  "version": "0.1.0",
  "license": "MIT-0",
  "exports": "./src/main.ts",

  // Auto-generated: Run with `deno task {task-name}`.
  "tasks": {
    "start": "deno run src/main.ts",
    "test": "deno test",
    "check": "deno fmt --check && deno lint && deno check",
    "compile": "deno compile --output dist/{project-acronym} src/main.ts",
    "compile-appimage": "deno compile --target x86_64-unknown-linux-gnu --output AppImage/Recipe/usr/bin/{project-acronym} src/main.ts"
  },

  // Auto-generated: Dependencies, e.g. "@std/assert": "jsr:@std/assert@^1.0.0". Versions are pinned in `deno.lock`.
  "imports": {},

  // Auto-generated: Strict type checking, used by `deno check`.
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },

  // Auto-generated: Linter settings, used by `deno lint`.
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-throw-literal",
        "default-param-last"
      ]
    }
  },

  // Auto-generated: Formatter settings (Deno style defaults), used by `deno fmt`.
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semiColons": true
  }
  // "exclude": ["{exclude-pattern}"]
}
